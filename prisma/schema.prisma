// ─────────────────────────────────────────────────────────
// CMS Crew Management System — Prisma Schema (SQLite sandbox)
// Diadaptasi dari repo 3SC (PostgreSQL) + fitur baru:
// TARGET BREAKDOWN: Toko → Zoning (Group) → Shift → Crew
//
// Prinsip desain (NO SNAPSHOT / NO HISTORY):
// - Target selalu dihitung REALTIME oleh src/lib/target-engine.ts
//   berdasarkan konfigurasi aktif + Crew.groupId + jadwal shift.
// - Tidak ada tabel snapshot target crew / histori assignment.
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── ZONING: tabel Group existing — SATU-SATUNYA sumber zoning ───
model Group {
  id            String  @id @default(cuid())
  name          String
  logo          String?
  monthlyTarget Float   @default(0)
  week1Target   Float   @default(0)
  week2Target   Float   @default(0)
  week3Target   Float   @default(0)
  week4Target   Float   @default(0)
  week5Target   Float   @default(0)
  // NEW: persentase kontribusi zoning terhadap Target Bulanan Toko.
  // Validasi: Σ allocationPct semua group = 100 (divalidasi di API store-config).
  // Group.monthlyTarget menjadi NILAI TURUNAN (write-through dari engine).
  allocationPct Float   @default(0)
  tiktokActive  Boolean @default(false)
  crews         Crew[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Crew {
  id          String      @id @default(cuid())
  name        String
  photo       String?
  employeeId  String      @unique
  groupId     String
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sales       Sale[]
  tiktokSales TikTokSale[]
  // NEW: jadwal shift per tanggal (roster aktif — bukan history target).
  // Target crew TIDAK pernah disimpan; selalu dihitung realtime dari sini.
  shifts      CrewShift[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ─── NEW: Target Bulanan Toko (sumber utama hierarchy) — singleton ───
model StoreConfig {
  id            String   @id @default(cuid())
  // Target Bulanan Toko (Rp). Σ Target Group = nilai ini (dijamin engine).
  monthlyTarget Float    @default(0)
  // Distribusi mingguan (% dari target bulanan). Validasi: Σ = 100.
  week1Pct      Float    @default(25)
  week2Pct      Float    @default(21)
  week3Pct      Float    @default(23)
  week4Pct      Float    @default(26)
  week5Pct      Float    @default(5)
  // Distribusi harian PER TANGGAL (% dari target bulanan) — JSON array 31 slot,
  // index 0 = tgl 1 .. index 30 = tgl 31 (slot tanggal di luar panjang bulan
  // diabaikan engine). MODE TUNGGAL — menggantikan bobot per hari-minggu lama
  // (dayPctMon..Sun). INVARIANT WAJIB (divalidasi UI & API):
  //   Σ slot tanggal dalam Week-w PERSIS = weekPct minggu tsb (tanpa selisih)
  //   → Σ semua minggu = 100% otomatis mengikuti distribusi mingguan.
  dailyPctsJson String @default("")
  updatedAt     DateTime @updatedAt
}

// ─── NEW: Bobot shift — CONFIGURABLE, tidak di-hardcode ───
// Default seed: P(Pagi)=1, S(Siang)=1, F(Full)=2, O(Off)=0
// Admin dapat mengubah bobot / menambah kode shift baru.
model ShiftType {
  id        String  @id @default(cuid())
  code      String  @unique // P, S, F, O, ...
  label     String // Pagi, Siang, Full, Off, ...
  weight    Float   @default(1) // bobot kontribusi target (O = 0)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

// ─── NEW: Jadwal shift crew per tanggal (yyyy-mm-dd, WIB) ───
// Ini ROSTER/plan operasional — BUKAN snapshot target & BUKAN history.
// Crew pindah zoning → otomatis ikut target zoning aktif (via Crew.groupId).
model CrewShift {
  id        String @id @default(cuid())
  crewId    String
  crew      Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  tanggal   String // yyyy-mm-dd
  shiftCode String // referensi logis ke ShiftType.code
  @@unique([crewId, tanggal])
  @@index([tanggal])
}

model Sale {
  id               String    @id @default(cuid())
  crewId           String?
  crew             Crew?     @relation(fields: [crewId], references: [id], onDelete: SetNull)
  tanggal          String
  idPenjualan      String?
  statusRetention  String?
  retentionCode    String?
  kodeExtend       String
  brand            String?
  dept             String?
  modul            String?
  ukuran           String?
  qty              Int       @default(0)
  hjp              Float     @default(0)
  netto            Float     @default(0)
  diskon           Float     @default(0)
  diskonRp         Float     @default(0)
  potongan         Float     @default(0)
  potonganV        Float     @default(0)
  settle           Float     @default(0)
  pembayaran       String?
  program          String?
  channelStock     String?
  claimedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([tanggal])
  @@index([kodeExtend])
  @@index([crewId])
  @@index([program])
  @@index([tanggal, kodeExtend])
  @@index([idPenjualan])
}

model TikTokSale {
  id        String   @id @default(cuid())
  crewId    String?
  crew      Crew?    @relation(fields: [crewId], references: [id], onDelete: SetNull)
  tanggal   String
  idOrder   String
  status    String   @default("Pengiriman")
  artikel   String
  size      String?
  qty       Int      @default(1)
  revenue   Float    @default(0)
  settle    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tanggal])
  @@index([crewId])
  @@index([status])
  @@index([idOrder])
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  description String
  crewName    String?
  saleId      String?
  metadata    String?
  createdAt   DateTime @default(now())
}
